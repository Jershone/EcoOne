# OneOS local DNS base domain. Configure router DNS to point these names to the Pi.
ONEOS_DOMAIN=oneos.home.arpa
TZ=Europe/Amsterdam

# Generated automatically by scripts/install.sh if these are still CHANGE_ME.
WEBUI_SECRET_KEY=CHANGE_ME
CONNECT_API_KEY=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_PASSWORD=CHANGE_ME
NEXTCLOUD_ADMIN_USER=oneosadmin
NEXTCLOUD_ADMIN_PASSWORD=CHANGE_ME

# Create a dedicated Nextcloud user and app password after first login.
NEXTCLOUD_CONNECT_USER=oneos-ai
NEXTCLOUD_CONNECT_APP_PASSWORD=

# Create a dedicated Home Assistant user/token after first login.
HOME_ASSISTANT_URL=http://host.docker.internal:8123
HOME_ASSISTANT_TOKEN=

# Set false after creating your first Open WebUI and Vaultwarden accounts.
OPEN_WEBUI_ENABLE_SIGNUP=true
VAULTWARDEN_SIGNUPS_ALLOWED=false

# Optional image tags (change only when you want to pin a tested version).
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:main
NEXTCLOUD_IMAGE=nextcloud:apache
HOME_ASSISTANT_IMAGE=ghcr.io/home-assistant/home-assistant:stable
NAVET_IMAGE=ghcr.io/awesomestvi/navet:latest
