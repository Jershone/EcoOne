# yaml-language-server: $schema=https://goauthentik.io/blueprints/schema.json
version: 1
metadata:
  name: omnexa-shared-browser-access
  labels:
    blueprints.goauthentik.io/instantiate: "true"
entries:
  - model: authentik_providers_proxy.proxyprovider
    state: present
    identifiers:
      name: omnexa-browser-access
    attrs:
      name: omnexa-browser-access
      mode: forward_domain
      external_host: "https://__TAILSCALE_HOST__:8444"
      cookie_domain: "__TAILSCALE_HOST__"
      access_token_validity: "hours=24"
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
  - model: authentik_core.application
    state: present
    identifiers:
      slug: omnexa-browser-access
    attrs:
      name: Omnexa protected browser apps
      slug: omnexa-browser-access
      meta_launch_url: "https://__TAILSCALE_HOST__:8443"
      policy_engine_mode: any
      provider: !Find [authentik_providers_proxy.proxyprovider, [name, omnexa-browser-access]]
  - model: authentik_outposts.outpost
    state: present
    identifiers:
      name: authentik Embedded Outpost
    attrs:
      name: authentik Embedded Outpost
      type: proxy
      providers:
        - !Find [authentik_providers_proxy.proxyprovider, [name, omnexa-browser-access]]
