#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"
if ! command -v node >/dev/null || ! command -v npm >/dev/null; then
  echo "EcoOne needs Node.js 22 or newer. Install it from https://nodejs.org/"; exit 1
fi
node -e "if(Number(process.versions.node.split('.')[0])<22){console.error('Node.js 22+ required');process.exit(1)}"
if [ ! -d node_modules/ws ]; then npm install --no-audit --no-fund; fi
npm start
