#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"

if [[ "${1:-}" == "--help" ]]; then
  echo "Usage: ./omnexa-run [--install]"
  echo "Installs Docker (if needed), configures Omnexa, enrolls this Pi in Tailscale, and starts the stack."
  exit 0
fi

if [[ $EUID -eq 0 ]]; then
  echo "Run this as your normal Raspberry Pi user, not with sudo."
  exit 1
fi

if ! command -v docker >/dev/null 2>&1; then
  echo "Installing Docker Engine..."
  curl -fsSL https://get.docker.com -o /tmp/omnexa-docker-install.sh
  sudo sh /tmp/omnexa-docker-install.sh
  rm -f /tmp/omnexa-docker-install.sh
  sudo usermod -aG docker "$USER"
  echo "Docker installed. Log out and back in so your account can use Docker, then run ./omnexa-run again."
  exit 0
fi

if ! docker compose version >/dev/null 2>&1; then
  echo "Docker Compose v2 is required. Install the Docker Compose plugin and rerun."
  exit 1
fi

if [[ ! -f .env ]]; then
  cp .env.example .env
fi

if grep -q 'CHANGE_ME' .env || ! grep -q '^AUTHENTIK_BOOTSTRAP_EMAIL=.' .env; then
  echo
  echo "First-time Omnexa administrator setup"
  read -rp "Administrator email: " admin_email
  [[ "$admin_email" == *@*.* ]] || { echo "Enter a valid email address."; exit 1; }
  read -rsp "Authentik administrator password (minimum 12 characters): " admin_password
  echo
  [[ ${#admin_password} -ge 12 ]] || { echo "Password must be at least 12 characters."; exit 1; }
  export OMNEXA_ADMIN_EMAIL="$admin_email" OMNEXA_ADMIN_PASSWORD="$admin_password"
  python3 - <<'PY'
from pathlib import Path
import os, secrets
p = Path(".env")
values = {
    "AUTHENTIK_BOOTSTRAP_EMAIL": os.environ["OMNEXA_ADMIN_EMAIL"],
    "AUTHENTIK_BOOTSTRAP_PASSWORD": os.environ["OMNEXA_ADMIN_PASSWORD"],
}
sizes = {
    "WEBUI_SECRET_KEY": 48,
    "CONNECT_API_KEY": 40,
    "MYSQL_ROOT_PASSWORD": 32,
    "MYSQL_PASSWORD": 32,
    "NEXTCLOUD_ADMIN_PASSWORD": 28,
    "AUTHENTIK_POSTGRES_PASSWORD": 36,
    "AUTHENTIK_SECRET_KEY": 60,
}
lines = p.read_text().splitlines()
out, seen = [], set()
for line in lines:
    if "=" in line and not line.lstrip().startswith("#"):
        key, value = line.split("=", 1)
        if key in values:
            value = values[key]
            seen.add(key)
        elif key in sizes and (value == "CHANGE_ME" or not value):
            value = secrets.token_urlsafe(sizes[key])
        # Compose's dotenv parser treats single-quoted values literally.
        if key in values:
            value = "'" + value.replace("\\", "\\\\").replace("'", "\\'") + "'"
        line = f"{key}={value}"
    out.append(line)
for key, value in values.items():
    if key not in seen:
        value = "'" + value.replace("\\", "\\\\").replace("'", "\\'") + "'"
        out.append(f"{key}={value}")
p.write_text("\n".join(out) + "\n")
PY
  unset OMNEXA_ADMIN_PASSWORD
  chmod 600 .env
fi

echo
echo "Checking Tailscale..."
if ! command -v tailscale >/dev/null 2>&1; then
  curl -fsSL https://tailscale.com/install.sh | sh
fi
if ! tailscale status >/dev/null 2>&1; then
  echo "A browser sign-in is required to add this Raspberry Pi to your existing tailnet."
  sudo tailscale up
fi

TAIL_DNS="$(tailscale status --json 2>/dev/null | python3 -c 'import json,sys; d=json.load(sys.stdin); print(d.get("Self",{}).get("DNSName","").rstrip("."))' 2>/dev/null || true)"
if [[ -z "$TAIL_DNS" ]]; then
  echo "Tailscale MagicDNS name is not available yet. Enable MagicDNS, then rerun ./omnexa-run."
  exit 1
fi
export OMNEXA_TAILSCALE_HOST="$TAIL_DNS"
python3 - <<'PY'
from pathlib import Path
import os
p=Path(".env")
lines=p.read_text().splitlines()
key="TAILSCALE_HOSTNAME"
value=os.environ["OMNEXA_TAILSCALE_HOST"]
out=[]
found=False
for line in lines:
    if line.startswith(key+"="):
        out.append(f"{key}={value}")
        found=True
    else:
        out.append(line)
if not found:
    out.append(f"{key}={value}")
p.write_text("\n".join(out)+"\n")
PY
unset OMNEXA_TAILSCALE_HOST

mkdir -p data/{caddy,caddy-config,open-webui,mariadb,redis,nextcloud,vaultwarden,homeassistant,navet,authentik-postgres,authentik-media,authentik-certs,authentik-custom-templates} backups
chmod 600 .env
docker compose config --quiet
echo "Pulling service images..."
docker compose pull
echo "Starting Omnexa..."
docker compose up -d --build --remove-orphans

echo
echo "Configuring private HTTPS endpoints with Tailscale Serve..."
SERVE_OK=1
sudo tailscale serve --bg --https=8443 http://127.0.0.1:80 || SERVE_OK=0
if [[ "$SERVE_OK" -eq 1 ]]; then
  sudo tailscale serve --bg --https=8444 http://127.0.0.1:9000 || echo "Warning: Authentik Serve route was not configured."
  sudo tailscale serve --bg --https=8445 http://127.0.0.1:3000 || echo "Warning: Open WebUI Serve route was not configured."
  sudo tailscale serve --bg --https=8446 http://127.0.0.1:8081 || echo "Warning: Nextcloud Serve route was not configured."
  sudo tailscale serve --bg --https=8447 http://127.0.0.1:8082 || echo "Warning: Vaultwarden Serve route was not configured."
  sudo tailscale serve --bg --https=8448 http://127.0.0.1:8083 || echo "Warning: Navet Serve route was not configured."
else
  echo "Tailscale HTTPS/Serve may need enabling in the tailnet admin console."
  echo "After enabling HTTPS certificates, rerun ./omnexa-run to configure the private routes."
fi

PI_IP="$(hostname -I | awk '{print $1}')"
TAIL_IP="$(tailscale ip -4 2>/dev/null | head -n1 || true)"
echo
echo "Omnexa containers:"
docker compose ps
echo
echo "Initial setup:"
echo "  Portal:       http://${TAIL_IP:-$PI_IP}"
echo "  Authentik:    http://${TAIL_IP:-$PI_IP}:9000"
echo "  Open WebUI:   http://${TAIL_IP:-$PI_IP}:3000"
echo
if [[ -n "$TAIL_IP" ]]; then
  echo "Private Tailscale IP: $TAIL_IP"
  echo "Nextcloud:     http://$TAIL_IP:8081"
  echo "Vaultwarden:   http://$TAIL_IP:8082"
  echo "Navet:         http://$TAIL_IP:8083"
  echo "Home Assistant:http://$TAIL_IP:8123"
  echo "Use this IP from your other devices after installing Tailscale and joining the same tailnet."
fi
echo
TAIL_DNS="$(tailscale status --json 2>/dev/null | python3 -c 'import json,sys; d=json.load(sys.stdin); print(d.get("Self",{}).get("DNSName","").rstrip("."))' 2>/dev/null || true)"
if [[ -n "$TAIL_DNS" ]]; then
  echo
  echo "Private HTTPS addresses (Tailscale Serve):"
  echo "  Portal:       https://$TAIL_DNS:8443"
  echo "  Authentik:    https://$TAIL_DNS:8444"
  echo "  Open WebUI:   https://$TAIL_DNS:8445"
  echo "  Nextcloud:    https://$TAIL_DNS:8446"
  echo "  Vaultwarden:  https://$TAIL_DNS:8447"
  echo "  Navet:        https://$TAIL_DNS:8448"
  echo "  Home Assistant: http://$TAIL_IP:8123 (private tailnet traffic)"
fi
echo "Create users and app providers in Authentik. See docs/authentication.md."
if command -v xdg-open >/dev/null 2>&1 && [[ -n "${DISPLAY:-}" ]]; then
  xdg-open "http://${PI_IP}:9000" >/dev/null 2>&1 || true
fi
echo "Do not configure router port forwarding. DuckDNS is not used as a public ingress."
