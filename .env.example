# Omnexa public DNS name. DuckDNS points this name at your home public IP.
# Tailscale remains the private remote-access path; do not port-forward app ports.
ONEOS_DOMAIN=omnexa.duckdns.org
TZ=Europe/Amsterdam

# Generated by omnexa-run. Do not commit your real .env file.
WEBUI_SECRET_KEY=CHANGE_ME
CONNECT_API_KEY=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_PASSWORD=CHANGE_ME
NEXTCLOUD_ADMIN_USER=om nexaadmin
NEXTCLOUD_ADMIN_PASSWORD=CHANGE_ME

AUTHENTIK_TAG=2026.8.0
AUTHENTIK_POSTGRES_PASSWORD=CHANGE_ME
AUTHENTIK_SECRET_KEY=CHANGE_ME
AUTHENTIK_BOOTSTRAP_EMAIL=
AUTHENTIK_BOOTSTRAP_PASSWORD=CHANGE_ME

# Configure the Open WebUI OIDC provider in Authentik, then paste its details here.
OPEN_WEBUI_ENABLE_OAUTH_SIGNUP=true
OPEN_WEBUI_OAUTH_CLIENT_ID=
OPEN_WEBUI_OAUTH_CLIENT_SECRET=
OPEN_WEBUI_OPENID_PROVIDER_URL=

NEXTCLOUD_CONNECT_USER=om nexa-ai
NEXTCLOUD_CONNECT_APP_PASSWORD=
HOME_ASSISTANT_URL=http://host.docker.internal:8123
HOME_ASSISTANT_TOKEN=
VAULTWARDEN_SIGNUPS_ALLOWED=false

OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:main
NEXTCLOUD_IMAGE=nextcloud:apache
HOME_ASSISTANT_IMAGE=ghcr.io/home-assistant/home-assistant:stable
NAVET_IMAGE=ghcr.io/awesomestvi/navet:latest
